{
  "mcpServers": {
    "uemcp": {
      "command": "node",
      "args": ["<UEMCP_REPO_PATH>/server/server.mjs"],
      "env": {
        "UNREAL_TCP_PORT_CUSTOM": "55558",
        "UNREAL_TCP_TIMEOUT_MS": "10000",
        "UNREAL_RC_PORT": "30010",
        "UNREAL_AUTO_DETECT": "true"
      }
    }
  }
}
