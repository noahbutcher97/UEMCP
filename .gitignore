# Node.js (server/)
node_modules/
dist/
*.tsbuildinfo
.env
.env.local

# OS
.DS_Store
Thumbs.db
Desktop.ini

# IDE
.vscode/
.idea/
*.swp
*.swo

# UE plugin build artifacts (match any nesting under plugin/)
plugin/**/Binaries/
plugin/**/Intermediate/
plugin/**/DerivedDataCache/

# Fixture project generated output (text fixture is committed; build output is not)
server/fixtures/**/Binaries/
server/fixtures/**/Intermediate/
server/fixtures/**/Saved/
server/fixtures/**/DerivedDataCache/
*.sln
*.vcxproj*

# Logs
*.log

# Test rotation snapshot — runtime artifact from run-rotation.mjs --snapshot.
# Per-checkout aggregate counts; useful for local drift detection, not source.
server/.test-rotation-snapshot.json

# MCP config (per-machine — template is .mcp.json.example)
.mcp.json
.claude/settings.local.json

# Q3 dev-workflow targets config (per-machine, contains real codename paths;
# read by verify-deploy.bat + setup-watcher.bat via server/verify-deploy.mjs).
.uemcp-targets.json
.uemcp-targets.txt

# Sibling AI-tool per-machine config (Codex CLI).
.codex/

# Local linked worktrees for isolated feature work.
.worktrees/

# Local superpowers workflow scratch files.
.superpowers/

# Orchestrator-state snapshots (local-only working memory across sessions;
# may contain codenames, local paths, sensitive orchestration details).
docs/tracking/orchestrator-state-*.md

# Session-local documentation (handoffs, worker reports, audits, testing logs, research)
# These are artifacts of individual agent dispatches, not product docs.
# Kept on disk for local reference; not tracked in the public repo.
docs/handoffs/
docs/reports/
docs/audits/
docs/testing/
docs/research/

# Sanitization scratch — these files contain literal sensitive tokens.
# Used during one-off filter-repo passes; never tracked.
.filter-repo-replacements.txt
.filter-repo-mailmap.txt
.git-rewrite/

# Backup bundles
*.bundle
