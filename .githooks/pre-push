#!/usr/bin/env bash
# Pre-push: scan outgoing commits (file diff + commit messages) for NDA
# codenames listed in .git/info/forbidden-tokens (per-checkout, untracked).
#
# This is the only enforcement layer for codenames; the same hook also runs
# the plugin compile gate (WS2 block below). Free to commit anything locally;
# the gate is at push time when content actually goes public.
#
# Bypass: git push --no-verify
set -u

# Force UTF-8 locale — empty LANG on Git Bash for Windows causes
# `grep -F -i -f` to silently miss matches on lines containing
# multi-byte chars (Unicode box-drawing in CLAUDE.md, em-dashes in
# READMEs). Without this export, the pre-push gate is leakier than
# it appears. Discovered by DOCS-GROOMING worker 2026-04-26 while
# wiring the matching .githooks/pre-commit hook.
export LC_ALL=C.UTF-8

resolve_git_info_file() {
  local rel="$1"
  local path=""
  local common=""

  path="$(git rev-parse --git-path "$rel" 2>/dev/null || true)"
  common="$(git rev-parse --git-common-dir 2>/dev/null || true)"

  if [[ -n "$path" && -f "$path" ]]; then
    printf '%s\n' "$path"
    return 0
  fi
  if [[ -n "$common" && -f "$common/$rel" ]]; then
    printf '%s\n' "$common/$rel"
    return 0
  fi
  if [[ -n "$path" ]]; then
    printf '%s\n' "$path"
    return 0
  fi

  printf '%s\n' ".git/$rel"
}

tokens="$(resolve_git_info_file "info/forbidden-tokens")"
if [[ ! -f "$tokens" ]]; then
  echo "" >&2
  echo "⚠ UEMCP NDA-codename hook: forbidden-tokens is ABSENT for this checkout." >&2
  echo "  Per CLAUDE.md §Public-Repo Hygiene, this file is per-checkout one-time setup." >&2
  echo "  Without it, the codename gate is not active in this checkout." >&2
  echo "  Action: populate $tokens with one codename per line." >&2
  echo "  Continuing without gate (this hook will exit 0)." >&2
  echo "" >&2
  exit 0
fi

literals="$(mktemp)"
regexes="$(mktemp)"
trap 'rm -f "$literals" "$regexes"' EXIT

while IFS= read -r line || [[ -n "$line" ]]; do
  [[ -z "${line// /}" || "${line:0:1}" == "#" ]] && continue
  if [[ "$line" == regex:* ]]; then
    printf '%s\n' "${line#regex:}" >> "$regexes"
  else
    printf '%s\n' "$line" >> "$literals"
  fi
done < "$tokens"

if [[ ! -s "$literals" && ! -s "$regexes" ]]; then
  exit 0
fi

zero="0000000000000000000000000000000000000000"
remote_name="${1:-}"

# gate_checked persists across loop iterations only because this `while read`
# consumes the hook's stdin directly (git feeds one ref-update line per
# iteration) rather than through a subshell-spawning pipe; a pipe would put
# the loop body in a subshell and reset the flag every iteration.
gate_checked=0

while read -r local_ref local_sha remote_ref remote_sha; do
  [[ "$local_sha" == "$zero" ]] && continue   # branch deletion

  if [[ "$remote_sha" == "$zero" ]]; then
    # A new branch has no remote tip for a simple A..B range. Exclude only
    # commits already reachable from this destination remote. Excluding every
    # configured remote could let a private mirror weaken a public push gate.
    scan_args=("$local_sha")
    while IFS= read -r ref; do
      [[ -n "$ref" ]] && scan_args+=("^$ref")
    done < <(git for-each-ref --format='%(refname)' "refs/remotes/$remote_name/" 2>/dev/null)
    content="$(git log -p --no-color "${scan_args[@]}" 2>/dev/null; git log --format='%B' "${scan_args[@]}" 2>/dev/null)"
    range_label="new-branch unpublished commits from $local_sha"
  else
    content="$(git log -p --no-color "${remote_sha}..${local_sha}" 2>/dev/null; git log --format='%B' "${remote_sha}..${local_sha}" 2>/dev/null)"
    range_label="${remote_sha}..${local_sha}"
  fi

  [[ -z "$content" ]] && continue

  # Plugin compile gate (WS2): refuse to publish plugin source that a local
  # target has built before but not since. Uses verify-deploy's per-target
  # verdicts. Ignored: MISSING targets (not installed here) and the two
  # never-built reasons — NEEDS-DEPLOY "DLL missing" and NEEDS-BUILD
  # "not built" — neither is evidence of a stale build, only that this
  # target has never been built here. Blocks on NEEDS-SYNC, and on
  # NEEDS-BUILD or NEEDS-DEPLOY when a DLL exists. Bypass: git push
  # --no-verify or UEMCP_SKIP_COMPILE_GATE=1.
  #
  # Runs before the codename scan below (fail-closed): a push blocked here
  # never reaches the scan, so a retry after fixing the build reports
  # codenames on that retry, not this one — nothing leaks either way.
  #
  # Evaluated at most once per push, not once per ref: verify-deploy's CIM
  # process scan is expensive, and the verdict doesn't depend on which ref
  # triggered it. gate_checked is set only once verify-deploy actually runs,
  # so a ref that touches no plugin source never consumes the one evaluation.
  if [[ -z "${UEMCP_SKIP_COMPILE_GATE:-}" && "$gate_checked" == "0" ]]; then
    if [[ "$remote_sha" == "$zero" ]]; then
      touched="$(git log --name-only --pretty=format: "${scan_args[@]}" 2>/dev/null)"
    else
      touched="$(git log --name-only --pretty=format: "${remote_sha}..${local_sha}" 2>/dev/null)"
    fi
    if printf '%s\n' "$touched" | grep -qE '^plugin/UEMCP/(Source/|UEMCP\.uplugin$)'; then
      if [[ -f .uemcp-targets.json || -f .uemcp-targets.txt ]]; then
        gate_checked=1
        gate_profile="${UEMCP_PUSH_GATE_PROFILE:-}"
        if [[ -z "$gate_profile" ]] && grep -q '"smoke"' .uemcp-targets.json 2>/dev/null; then gate_profile="smoke"; fi
        gate_rc=0
        gate_out="$(node server/verify-deploy.mjs --quiet --no-color ${gate_profile:+--profile "$gate_profile"} < /dev/null 2>&1)" || gate_rc=$?
        stale="$(printf '%s\n' "$gate_out" | grep -E '^\s*Verdict: (NEEDS-SYNC|NEEDS-BUILD|NEEDS-DEPLOY)' | grep -v -e 'DLL missing' -e 'not built' || true)"
        if [[ "$gate_rc" -ne 0 ]] && ! printf '%s\n' "$gate_out" | grep -q '^\s*Verdict:'; then
          # verify-deploy could not produce verdicts at all (e.g. a bad
          # --profile) — this is a config problem on this machine, not
          # evidence of a stale build. Warn, never block.
          echo "  (compile gate could not evaluate: verify-deploy exited $gate_rc; profile: ${gate_profile:-default})" >&2
        elif [[ -n "$stale" ]]; then
          {
            echo ""
            echo "✗ Push blocked: plugin source changed but a target has not been rebuilt ($range_label)"
            echo ""
            printf '%s\n' "$gate_out" | grep -E '^\s*\[[0-9]+\] |^\s*Verdict: '
            echo ""
            echo "  Run sync-plugin.bat / Build.bat for the target, or bypass with 'git push --no-verify'"
            echo "  (or UEMCP_SKIP_COMPILE_GATE=1). Gate profile: ${gate_profile:-default}."
            echo ""
          } >&2
          exit 1
        fi
      else
        echo "  (compile gate skipped: no .uemcp-targets.json on this machine)" >&2
      fi
    fi
  fi

  hits=""
  if [[ -s "$literals" ]]; then
    m="$(printf '%s\n' "$content" | grep -F -i -n -f "$literals" 2>/dev/null | head -10 || true)"
    [[ -n "$m" ]] && hits+="$m"$'\n'
  fi
  if [[ -s "$regexes" ]]; then
    m="$(printf '%s\n' "$content" | grep -E -i -n -f "$regexes" 2>/dev/null | head -10 || true)"
    [[ -n "$m" ]] && hits+="$m"$'\n'
  fi

  if [[ -n "$hits" ]]; then
    {
      echo ""
      echo "✗ Push blocked: NDA codename detected in outgoing diff ($range_label)"
      echo ""
      printf '%s' "$hits"
      echo ""
      echo "  Edit content to remove/replace, or bypass with 'git push --no-verify'."
      echo "  Token list: .git/info/forbidden-tokens"
      echo ""
    } >&2
    exit 1
  fi
done

exit 0
