{
  "permissions": {
    "allow": [
      "Bash(npm install:*)",
      "Bash(npm run:*)",
      "Bash(node:*)",
      "Bash(git:*)",
      "Bash(cat:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(ls:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)"
    ],
    "deny": []
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "command -v node >/dev/null 2>&1 && node \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/codename-scan.mjs\" || true",
            "statusMessage": "Scanning for NDA codenames"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "command -v node >/dev/null 2>&1 && node \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/mjs-syntax-check.mjs\" || true",
            "statusMessage": "Checking .mjs syntax"
          }
        ]
      }
    ]
  }
}
